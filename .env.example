# true forces sample data even when a key is present.
# false (or unset) uses Flynet whenever FLYNET_API_KEY is set.
USE_FIXTURES=true

# Discovery API key from make.flynet.org. Header: X-API-Key.
# 40 characters, prefixed fly_test_ (staging) or fly_live_ (production).
# A flyotk_ value is a one-hour setup token, not a key — mint the key first.
FLYNET_API_KEY=

# Written by the Make setup redeem call when OAuth credentials come with it.
# FLYNET_CLIENT_ID=
# REDIRECT_URI=

# Optional: force a Discovery base URL instead of deriving it from the key prefix.
# FLYNET_BASE_URL=https://api.staging.blackbird.xyz/flynet/v1

# Mapbox public token (pk.). NEXT_PUBLIC_ is the one the browser uses.
MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# Upstash Redis (free tier) — makes meetup codes survive restarts and work
# across serverless instances. Leave both unset to use the in-memory store
# (fine for a single-process dev server, broken once deployed).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
